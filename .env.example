# ==============================================================================
# DEFENDX: Securing Adversarial AI – Safety Testing Infrastructure
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development

# Database Connection URL
# For development SQLite (Zero configuration needed):
DATABASE_URL=sqlite+aiosqlite:///./defendx.db
# For production PostgreSQL via Docker:
# DATABASE_URL=postgresql+asyncpg://defendx_user:defendx_secure_pass_2026@localhost:5432/defendx_db

# Cryptographic Session & JWT Security
JWT_SECRET_KEY=defendx_super_secret_jwt_key_change_in_production_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Development Authentication Mode
# Enables instant test persona login for local testing. Must be false in production!
DEV_AUTH_ENABLED=true

# Google OAuth 2.0 / OpenID Connect Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# Upload Storage & Security Limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Malware Scanner (ClamAV Daemon)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# AI Model Evaluation Engine
# Supported: "mock" (built-in deterministic simulator), "openai", "gemini"
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_NAME=defendx-evaluator-v1
LLM_BASE_URL=

# Frontend Configuration (for frontend/.env.local or root)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public Google OAuth Client ID for Google Identity Services in browser
# Must match GOOGLE_CLIENT_ID in backend. NEVER put client secret here!
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
